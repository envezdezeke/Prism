# Copy to .env (gitignored) and fill in. Never commit .env.
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-nano-3-30b-a3b
NEMOTRON_VL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# off | replay | live
NEMOTRON_MODE=live
